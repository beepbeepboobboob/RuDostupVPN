	      {
	        "type": "tcp",
	        "tag": "local",
	        "server": "1.1.1.1"
	      }
    ]
   },
   "inbounds": [
      {
         "type": "socks",
         "tag": "socks-in",
         "listen": "127.0.0.1",
         "listen_port": 31730
      },
      {
         "type": "tun",
         "tag": "tun-in",
         "interface_name": "tun0",
         "address": [
            "172.19.0.1/30",
            "fdfe:dcba:9876::1/126"
         ],
         "mtu": 1500,
         "auto_route": true, 
         "strict_route": false,
         "stack": "system"
      }
   ],
   "outbounds": [
      {
         "type": "vless",
         "tag": "vless2",
         "server": "45.25.260.56",
         "server_port": 443,
         "uuid": "21243343-1223-1123-3341-757828375768",
         "tls": {
            "enabled": true,
            "utls": {
               "enabled": false,
               "fingerprint": "chrome"
